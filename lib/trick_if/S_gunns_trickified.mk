#
# Make sure the user has defined $GUNNS_HOME.
ifeq ($(wildcard $(GUNNS_HOME)),)
    $(error $GUNNS_HOME must be set to your project's gunns/ folder.)
endif

# Specify root paths for header file includes.
TRICK_CFLAGS   += -I$(GUNNS_HOME)/include/gunns -I$(GUNNS_HOME)/include/gunns/ms-utils -I$(GUNNS_HOME)/include/gunns/gunns-ts-models
TRICK_CXXFLAGS += -I$(GUNNS_HOME)/include/gunns -I$(GUNNS_HOME)/include/gunns/ms-utils -I$(GUNNS_HOME)/include/gunns/gunns-ts-models

# Make GUNNS_HOME available to the sim at run time.
TRICK_EXT_LIB_DIRS += :$(GUNNS_HOME)

# Tell Trick where to find the Python modules generated by SWIG.
TRICK_PYTHON_PATH += :Modified_data/gunns_python.zip

TRICK_USER_LINK_LIBS += ${GUNNS_HOME}/lib64/libgunns.a

$(S_MAIN): Modified_data/gunns_python.zip

Modified_data/gunns_python.zip:
	ln -snf $(GUNNS_HOME)/lib/gunns/python/gunns_python.zip $@

